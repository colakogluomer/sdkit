# Everything in .sdkit/ is shared through git except what is personal or generated on each machine.
# Personal settings (limits, memory behaviour, hosts and models differ per developer); sdkit.env is the team's and is committed
sdkit.local.env
sdkit.local.env.bak
# a root .gitignore rule such as *.env would hide the shared file; it holds settings only, never secrets
!sdkit.env
# Working state: task state, plans, notes, token ledger, lookup cache
work/
.frozen
.verify-cache/
.sdd/
.cc-writes/
# Generated by `sdkit init` / `sdkit sync`; identical for everyone, rebuilt on each machine
hooks/
roles/
tiers.env
.scaffold-manifest
.scaffold-manifest.new
.scaffold-shared
.scaffold-version
# kit script copies (brew-less installs); the two the server-side CI gate runs stay in git
scripts/*
!scripts/sdd.sh
!scripts/resolve-base.sh
