# Model cost tiers used by bin/build-adapters.sh. Roles declare a tier, never a model name.
# Claude Code: aliases accepted in an agent's `model:` field. Codex: reasoning effort, plus an optional model per tier.
# Leave a CODEX_MODEL_* value empty to inherit the session's model (recommended unless you want hard pinning).
CLAUDE_MODEL_LIGHT=haiku
CLAUDE_MODEL_STANDARD=sonnet
CLAUDE_MODEL_STRONG=opus

CODEX_EFFORT_LIGHT=low
CODEX_EFFORT_STANDARD=medium
CODEX_EFFORT_STRONG=high
CODEX_MODEL_LIGHT=
CODEX_MODEL_STANDARD=
CODEX_MODEL_STRONG=

# OpenCode: provider/model-id. The defaults below need an Anthropic provider configured in OpenCode; blank them to inherit the session's model.
# Cursor: model id or `inherit`. Gemini: model id (e.g. gemini-2.5-flash).
# Cursor and Gemini are left empty on purpose: the kit does not guess model names for them. Empty = inherit the session's model.
# `run-role.sh --tier` and the per-task `size:` routing (references/model-routing.md) use these values.
OPENCODE_MODEL_LIGHT=anthropic/claude-haiku-5-5
OPENCODE_MODEL_STANDARD=anthropic/claude-sonnet-5-5
OPENCODE_MODEL_STRONG=anthropic/claude-opus-5-5
CURSOR_MODEL_LIGHT=
CURSOR_MODEL_STANDARD=
CURSOR_MODEL_STRONG=
GEMINI_MODEL_LIGHT=
GEMINI_MODEL_STANDARD=
GEMINI_MODEL_STRONG=
