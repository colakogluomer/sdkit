# Per-host tool and permission names used by bin/emit/*.sh. Roles declare an `access` class, never a host tool name.

# Shell commands a read-only role may run (shell glob patterns, '|' separated). Everything else is denied for read-only roles
# where the host can express it (OpenCode permissions, hooks/guard-readonly.sh). Add project test runners via
# READONLY_SHELL_EXTRA in <project-dir>/sdkit.env (hooks) or by editing the generated role file in the project.
READONLY_SHELL_ALLOW="git diff*|git log*|git show*|git status*|git rev-parse*|git merge-base*|git ls-files*|git blame*|ls*|cat*|head*|tail*|wc*|grep*|rg*|find*|*verify.sh*|go test*|go vet*|go build*|mvn *|./mvnw *|gradle *|./gradlew *|npm test*|npm run *|pnpm *|yarn *|npx tsc*|npx eslint*|npx jest*|npx vitest*"

# Gemini CLI tool names (docs/core/subagents.md). Write/edit names are UNVERIFIED in the fetched docs; check with `gemini` /tools.
GEMINI_TOOLS_READ="read_file, grep_search, glob, list_directory, run_shell_command"
GEMINI_TOOLS_WRITE="write_file, replace"

# OpenCode permission key for the shell tool: `shell` in current docs, `bash` in older releases.
OPENCODE_SHELL_KEY=shell
