DESCRIPTION="Contract chain: seven agents, every handoff and result contracted, later handoffs name earlier outputs as READ (reviewer and verifier on another host)"
GROUP=contract
CONTRACT=1
RISK=medium
TEST_CMD="bash test.sh"
VERIFIER_HOST=codex
STEPS="scout:scout@proposed plan:engineer@proposed tw:test-writer@red dev-a:developer,dev-b:developer@green review:reviewer@green verify:verifier@verified"
