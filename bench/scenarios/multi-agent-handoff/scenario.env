DESCRIPTION="Multi-agent: scout, engineer, test-writer, two developers in parallel, then reviewer and verifier on another host (VERIFIER_HOST applies to both)"
RISK=medium
TEST_CMD="bash test.sh"
VERIFIER_HOST=codex
STEPS="scout:scout@proposed plan:engineer@proposed tw:test-writer@red dev-a:developer,dev-b:developer@green review:reviewer@green verify:verifier@verified"
