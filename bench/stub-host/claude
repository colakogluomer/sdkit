#!/usr/bin/env bash

# Deterministic stand-in for a host CLI, used by bench/run.sh in simulated mode: no model, no network. It "does the work" of the step
# named in SDKIT_BENCH_STEP by copying the scenario's sim/<step>/ files into the working directory, and answers with
# answers/<step>.txt. Token usage comes from usage/<step> ("in out cache_read cache_write"); without that file it prints none,
# like a host that reports nothing. Everything it reports is a fixture, which is why simulated results carry mode "simulated".
. "$(dirname "$0")/stub-lib.sh"

if [ -f "$d/usage/$step" ]; then
  read -r i o cr cw < "$d/usage/$step"
  jq -n --arg r "$text" --argjson i "$i" --argjson o "$o" --argjson cr "$cr" --argjson cw "$cw" \
    '{result:$r, usage:{input_tokens:$i, output_tokens:$o, cache_read_input_tokens:$cr, cache_creation_input_tokens:$cw}}'
else
  jq -n --arg r "$text" '{result:$r}'
fi
